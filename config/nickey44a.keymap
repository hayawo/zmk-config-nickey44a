#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// 大西配列。hayawo/zmk-SIDE48 (config/side48.keymap) に合わせている。
// SIDE48 の 5 段目 (最下段) は親指キー 3 個 + 内側キー 1 個に割り当て:
//   左: LWIN(内側) / LALT SPACE SYMBOL(親指)
//   右: GRAVE=半角/全角(内側) / BS Enter ARROW(親指)
// W / P / = 長押し=FUNC_NUM、T 長押し=ARROW (SIDE48 と同じ)。
// トラックボールが無いため SIDE48 の MOUSE / FUNCTION / SPARE レイヤーは省略。
//
// レイヤー: 0 BASE / 1 SYMBOL / 2 FUNC_NUM / 3 ARROW

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        // SIDE48 と同じ: SYMBOL レイヤーで V + ; 同時押しで BT_CLR

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
&kp ESC           &kp Q  &kp L  &kp U  &kp COMMA     &kp PERIOD                                &kp F      &lt 2 W      &kp R  &kp Y  &kp P    &kp EQUAL
&kp LEFT_CONTROL  &kp E  &kp I  &kp A  &kp O         &kp MINUS                                 &kp K      &lt 3 T      &kp N  &kp S  &kp H    &kp SQT
&kp LSHFT         &kp Z  &kp X  &kp C  &kp V         &kp SEMICOLON  &kp LEFT_WIN    &kp SLASH  &kp G      &kp D        &kp M  &kp J  &lt 3 B  &kp NON_US_BACKSLASH
                                       &kp LEFT_ALT  &kp SPACE      &mo 1           &kp BSPC   &kp ENTER  &lt 2 GRAVE
            >;
        };

        layer_1 {
            display-name = "SYMBOL";
            bindings = <
&kp TAB  &kp N1    &kp N2  &kp N3    &kp N4        &kp N5                           &kp N6     &kp N7           &kp N8           &kp N9                &kp N0                 &kp DELETE
&trans   &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR    &kp PRCNT                        &kp CARET  &kp AMPERSAND    &kp ASTRK        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans   &trans    &trans  &trans    &kp SLASH     &kp QUESTION  &trans    &trans   &kp TILDE  &kp LEFT_BRACE   &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH
                                     &kp LEFT_GUI  &trans        &trans    &kp DEL  &trans     &kp PRINTSCREEN
            >;
        };

        layer_2 {
            display-name = "FUNC_NUM";
            bindings = <
&kp ESCAPE    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                            &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans        &trans        &trans        &trans        &trans        &trans                            &trans  &trans  &trans  &trans  &trans   &kp F11
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans   &trans
                                                        &kp CAPS      &trans  &kp SCROLLLOCK    &trans  &trans  &trans
            >;
        };

        layer_3 {
            display-name = "ARROW";
            bindings = <
&kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7    &kp F8    &kp F9     &kp F10  &kp F12
&trans      &trans  &trans  &trans  &trans  &trans                    &trans  &kp HOME  &kp UP    &kp END    &trans   &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
                                    &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
