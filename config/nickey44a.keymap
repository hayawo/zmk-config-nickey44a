#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// 大西配列。hayawo/zmk-SIDE48 (config/side48.keymap) をもとに調整。
// Nickey44A-PAD: 左右の内側キー位置に TPS43 トラックパッドを載せたため、
//   内側キー (旧 LEFT_WIN / SLASH) は &none。
// 親指キー 3 個:
//   左: Alt Space SYMBOL
//   右: BS Enter, タップ=GRAVE(半角/全角) 長押し=FUNC_NUM
// トラックパッドの動作は docs/dual-tps43.md を参照。
//   Layer 1 (SYMBOL) 中は右パッドが Snipe (移動量 2/3) になり、
//   2本指左右スワイプが進む/戻る → タブ移動に切り替わる。
// H 長押し=ARROW。
// BT_CLR は誤爆で接続が切れるため割り当てていない。
//   ペアリング情報を消したいときは settings_reset を左右に書き込む
//   (全プロファイルと左右間の接続が消えるので、書き戻して再ペアリング)。
// ZMK Studio のロック解除 (&studio_unlock) は FUNC_NUM の - の位置 (Caps の上)。
// SIDE48 の MOUSE / FUNCTION / SPARE レイヤーは省略 (ポインティングはパッド側で処理)。
//
// レイヤー: 0 BASE / 1 SYMBOL / 2 FUNC_NUM / 3 ARROW

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
&kp ESC           &kp Q  &kp L  &kp U  &kp COMMA     &kp PERIOD                                &kp F      &kp W        &kp R  &kp Y  &kp P    &kp EQUAL
&kp LEFT_CONTROL  &kp E  &kp I  &kp A  &kp O         &kp MINUS                                 &kp K      &kp T        &kp N  &kp S  &lt 3 H  &kp SQT
&kp LSHFT         &kp Z  &kp X  &kp C  &kp V         &kp SEMICOLON  &none          &none      &kp G      &kp D        &kp M  &kp J  &kp B    &kp NON_US_BACKSLASH
                                       &kp LEFT_ALT  &kp SPACE      &mo 1           &kp BSPC   &kp ENTER  &lt 2 GRAVE
            >;
        };

        layer_1 {
            display-name = "SYMBOL";
            bindings = <
&kp TAB  &kp N1    &kp N2  &kp N3    &kp N4      &kp N5                           &kp N6          &kp N7           &kp N8           &kp N9                &kp N0                 &kp DELETE
&trans   &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT                        &kp CARET       &kp AMPERSAND    &kp ASTRK        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans   &trans    &trans  &trans    &kp SLASH   &kp QUESTION  &trans    &trans   &kp TILDE       &kp LEFT_BRACE   &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH
                                     &trans      &trans        &trans    &kp DEL  &kp SCROLLLOCK  &kp PRINTSCREEN
            >;
        };

        layer_2 {
            display-name = "FUNC_NUM";
            bindings = <
&kp ESCAPE    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                      &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans        &trans        &trans        &trans        &trans        &studio_unlock              &trans  &trans  &trans  &trans  &trans   &kp F11
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp CAPS  &trans    &trans  &trans  &trans  &trans  &trans  &trans   &trans
                                                        &kp LEFT_GUI  &trans    &trans    &trans  &trans  &trans
            >;
        };

        layer_3 {
            display-name = "ARROW";
            bindings = <
&kp ESCAPE  &none  &none  &none  &none   &none                         &none  &kp HOME        &kp UP_ARROW    &kp END          &none  &none
&trans      &none  &none  &none  &none   &none                         &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none  &none
&trans      &none  &none  &none  &none   &none  &none           &none  &none  &none           &none           &none            &none  &none
                                 &trans  &none  &kp LEFT_GUI    &none  &none  &none
            >;
        };
    };
};
